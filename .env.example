# =============================================================================
# MEDFREE — environment variables
# Copy to .env and fill in. NEVER commit the real .env.
# =============================================================================

# --- Frontend (apps/web) -----------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Relative keeps local dev simple; set to the hosted backend in production.
NEXT_PUBLIC_API_URL=/api
# SSR + In this dev proxy, point to the local backend. Set to the Render/Railway
# URL in production (e.g. https://medfree-api.onrender.com).
MEDFREE_API_URL=http://127.0.0.1:8000

# Supabase Auth (frontend). Leave blank for local/preview without Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Backend (apps/api) ------------------------------------------------------
# auth_provider = mock (dev) | supabase (prod)
AUTH_PROVIDER=mock
# Auth verification: when SUPABASE_URL is set, MEDFREE validates access tokens
# against the project JWKS (supports modern ES256/RS256 signing). SUPABASE_JWT_SECRET
# is used only as a fallback for legacy HS256 projects.
AUTH_BYPASS=true
ENVIRONMENT=development
DEBUG=false
# Managed PostgreSQL (Supabase / Railway / Render). Empty → local sqlite file.
DATABASE_URL=

# Supabase (used by SupabaseAuthProvider + service role for admin ops).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
AUTH_JWT_AUDIENCE=authenticated

# S3-compatible object storage. Empty → local disk stub (./storage).
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=medfree
STORAGE_REGION=auto
# Local/dev storage directory when no S3 creds are set.
STORAGE_LOCAL_ROOT=./storage
# Public base URL for served objects (e.g. public Supabase bucket or CDN). Leave empty to use presigned URLs.
STORAGE_PUBLIC_BASE_URL=
# Max upload size (MB) enforced at the API layer + local driver.
MAX_UPLOAD_MB=200

# --- Security / rate limiting ------------------------------------------------
# In-memory rate limiting in dev/CI; swaps to Redis when REDIS_URL is set.
RATE_LIMIT_ANON=60
RATE_LIMIT_AUTHED=300
RATE_LIMIT_AUTH=10
RATE_LIMIT_SEARCH=30
RATE_LIMIT_ADMIN=120
RATE_LIMIT_WINDOW=60
SECURITY_HEADERS=true

# --- AI study assistant ------------------------------------------------------
# Optional: swap the deterministic answer builder / hashed embeddings for a hosted
# model. Leave blank to use the offline, provider-agnostic path.
LLM_API_KEY=
EMBEDDING_PROVIDER=local   # local (hashed) | openai | sentence-transformers

# --- Managed Redis (optional; rate-limit/cache/queues) -----------------------
REDIS_URL=
